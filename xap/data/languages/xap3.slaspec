define endian=big;
define alignment=2;

define space ram     type=ram_space      size=2  default;

define space register type=register_space size=2;

define register offset=0x00 size=4 [ 
    R1_U
    R1_S
    R1_I
    R1_N
    R2_U
    R2_S
    R2_I
    R3
    R4
    R5
    R6
    R7
    R8
    R9
    R10
    R11
    R12
    R13
    R14_U
    R14_S
    R14_I
    R14_N
    R15_U
    R15_S
    R15_I

	flags
    SFLAGS_S
    SFLAGS_I
    SFLAGS_N

    GP_U
    GP_S
    GP_I

    IVTB
    BRKE

    BRK0
    BRK1
    BRK2
    BRK3
    BRK4
    BRK5
    BRK6
    BRK7
    BRK4COUNT
    BRK5COUNT
    BRK6COUNT
    BRK7COUNT
    BRK8MASK
    BRK7MASK
    BRK6DATA
    BRK7DATA
];


#define register offset=0x100 size=4 [
    #ctx
#];

#define context ctx
    #addrExt         = (  0, 31) noflow
#;

define bitrange E=flags[8,1]
                T=flags[7,1]
				B=flags[6,1]
				M1=flags[5,1]
				M0=flags[4,1]
				V=flags[3,1]
                C=flags[2,1]
                N=flags[1,1]
                Z=flags[0,1]
;

define token opbyte (32)
    op0_31 = (0, 31)
    op0_23 = (0, 23)
    op0_7  = (0, 7)
    op12_23  = (12, 23)
    op23  = (23, 23)
    offset = (7, 27)
    mov_offset = (9, 31)
    imm  = (7, 23)
    imm8_23  = (8, 23)
    imm7_22  = (7, 22)
    addr  = (7, 31)
    rs     = (24, 27)
    rd     = (28, 31)
    rt     = (8, 11)
    bra_offset = (7, 31)
    sel = (16, 17)
    shift = (17, 21)
    highbit = (12, 16)
    lowbit = (7, 11)
    imm20_23 = (20, 23)
    imm7_19 = (7, 19)
;

define token opbyte16 (16)
    op16_0_7   = (0, 7)
    rd16       = (12, 15)
    rt16       = (8, 11)
    op16_0_16  = (0, 15) #TODO name
    op16_0_11  = (0, 11)
    op16_0_3  = (0, 3)
    op16_12_15  = (12, 15)
    offset16 = (4, 11)
    offset16_4_13 = (4, 13)
    offset16_4_12 = (4, 12)
    op16_15 = (15, 15)
    rs3a = (13, 15)
    shift16 = (4, 8)
    rd3e = (9, 11)
;

