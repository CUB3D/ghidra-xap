:bgt.s tgt is op28_31=0b1011 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}

:bgt.u tgt is op28_31=0b1101 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(C != 0) goto inst_next;
    if(Z != 0) goto inst_next;
    goto [tgt];
}

:ble.s tgt is op28_31=0b1010 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    local skip:1 = (N == V) && (Z == 0);
    if(skip) goto inst_next;
    goto [tgt];
}

:ble.u tgt is op28_31=0b1100 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    local skip:1 = (C == 0) && (Z == 0);
    if(skip) goto inst_next;
    goto [tgt];
}

