:bra.a tgt is bra_offset & op0_6=0b0110001 [tgt = (bra_offset << 1);] {
    goto [tgt];
}
:bra.p tgt is bra_offset & op0_6=0b0110101 [tgt = inst_next + (bra_offset << 1);] {
