:div.s.r rd, rs, rt is rd & rs & op12_13=0b111111111010 & rt & op0_7=0b01111111 {
    rd = rs s/ rt;
    flags_nz(rd);
    # Only in priv mode
    V = (rt == 0) || ((rs == 0x80000000) && (rd==-1));
}
:div.u.r rd, rs, rt is rd & rs & op12_13=0b111111111011 & rt & op0_7=0b01111111 {
    rd = rs s/ rt;
    flags_nz(rd);
    # Only in priv mode
    C = (rt == 0);
}

define pcodeop flip_16b;
:flip.16b.r rd, rs, rt, "#"sel is rd & rs & op18_23=0b000100 & sel & op12_15=0b0101 & rt & op0_7=0b01111111 {
    rd = flip_16b(rs, rt, sel:1);
}
define pcodeop flip_16x; 
:flip.16x.r rd, rs, rt, "#"sel is rd & rs & op18_23=0b000100 & sel & op12_15=0b0010 & rt & op0_7=0b01111111 {
    rd = flip_16x(rs, rt, sel:1);
} 
define pcodeop flip_8x;
:flip.8x.r rd, rs, rt, "#"sel is rd & rs & op18_23=0b000100 & sel & op12_15=0b0011 & rt & op0_7=0b01111111 {
    rd = flip_8x(rs, rt, sel:1);
}
define pcodeop flip_b; 
:flip.b.r rd, rs, rt, "#"sel is rd & rs & op18_23=0b000100 & sel & op12_15=0b0100 & rt & op0_7=0b01111111 {
    rd = flip_b(rs, rt, sel:1);
}
define pcodeop flip;
:flip.r rd, rs, rt, "#"sel is rd & rs & op18_23=0b000100 & sel & op12_15=0b0000 & rt & op0_7=0b01111111 {
    rd = flip(rs, rt, sel:1);
