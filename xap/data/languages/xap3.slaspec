:ld.16s.i rd, rs, "@(" imm, ra ")" is rd & rs & imm & op0_6=0b1101111 {
    local ea:4 = imm + ra;
    local tmp:2 = *[ram]:2 ea;
    rd = sext(tmp);
    flags_nz(rd);
}
:ld.16s.r rd, "@(" rs, rt ")" is rd & rs & op12_23=0b111111100111 & rt & op0_7=0b01111111 {
    local ea:4 = rs + ra;
    local tmp:2 = *[ram]:2 ea;
    rd = sext(tmp);
    flags_nz(rd);
}

:ld.16z.i rd, rs, "@(" imm, ra ")" is rd & rs & imm & op0_6=0b1100011 {
    local ea:4 = imm + ra;
    local tmp:2 = *[ram]:2 ea;
    rd = zext(tmp);
    flags_nz(rd);
}
:ld.16z.i rd3e, "@(" rd3c, imm16_4_7 ")" is rd3e & ra3c & imm16_8_9=0b01 & imm16_4_7 & imm16_0_3=0b0100 {
    local ea:4 = rd3c + imm16_4_7;
