define pcodeop msbit;
:msbit.r rd, rs is rd & rs & op0_23=0b111111111110101001111111 {
    rd = msbit(rs);
}

:mult.16s.i rd, rs, "#"imm7_22 is rd & rs & op23=0 & imm7_22 & op0_6=0b1001101 {
    rd = sext(rs:2) * sext(imm7_22:2);
    
    Z = rd == 0;
    N = rd s< 0;
    V = (rs:2 == 0x8000) && (imm7_22:2 == 0x8000);
}

:mult.16s.r rd, rs, rt is rd & rs & op12_23=0b111111110110 & rt & op0_7=0b01111111 {
    rd = sext(rs:2) * sext(rt:2);
    
    Z = rd == 0;
    N = rd s< 0;
    V = (rs:2 == 0x8000) && (rt:2 == 0x8000);
}

:mult.16u.i rd, rs, "#"imm7_22 is rd & rs & op23=0 & imm7_22 & op0_6=0b1001111 {
    rd = zext(rs:2) * zext(imm7_22:2);
#    
    Z = rd == 0;
    N = ((rd >> 31) & 1) == 1;
    C = 0;
}

:mult.16u.r rd, rs, rt is rd & rs & op12_23=0b11111110111 & rt & op0_7=0b01111111 {
    rd = zext(rs:2) * zext(rs:2);
    
    Z = rd == 0;
    N = ((rd >> 31) & 1) == 1;
    C = 0;
}

#TODO: flags

:mult.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1011101 {
    rd = rs * imm;
}
:mult.r rd, rs, rt is rd & rs & op12_23=0b111111111000 & rt & op0_7=0b01111111 {
    rd = rs * rt;
}
:mult.r rd16, rt16 is rd16 & rt16 & op16_0_7=0b01110000 {
    rd16 = rd16 * rt16;
}
:mult.sh rd, rs, rt "#"imm12_17 is rd & rs & op18_23=0b001000 & imm12_17 & rt & op0_7=0b01111111 {
    rd = (rs * rt) >> imm12_17;
}

define pcodeop nop;
:nop is op0_31=0b11111111111111111111111011111111 {
    nop();
}
:nop is op16_0_15=0b0001000000000000 {
    nop();
}

:or.h rd, rs, "#"h_imm is rd & rs & h_imm & op0_6=0b1001001 {
    rd = rs | h_imm;
    flags_nz(rd);
}
:or.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1011001 {
    rd = rs | imm;
    flags_nz(rd);
}
:or.r rd, rs, rt is rd & rs & op12_23=0b111111110100 & rt & op0_7=0b01111111 {
    rd = rs | rt;
    flags_nz(rd);
}
:or.r rd16, rt16 is rd16 & rt16 & op16_0_7=0b01010000 {
    rd16 = rt16 | rd16;
    flags_nz(rd16);
}

