define pcodeop stub;

# Take bits [31:15] from imm, repeat bit [15] into [14:0] of the imm
h_imm: is imm {
	local b15:4 = zext(imm:2);
	local low:2 = imm:2 & 0x8000;
	low = low s>> 15;
	local tmp:4 = b15 | zext(low);
	export *[const]:4 tmp;
}

# Take bits [31:15] from imm, repeat bit [15] into [14:0] of the imm
h_imm8_23: is imm8_23 {
	local b15:4 = zext(imm8_23:2);
	local low:2 = imm8_23:2 & 0x8000;
	low = low s>> 15;
	local tmp:4 = b15 | zext(low);
	export *[const]:4 tmp;
}

macro flags_nz(dest) {
	Z = dest != 0;
	N = dest s< 0;
}

:abs.r rd, rs is rd & rs & op0_23=0b111111101101011111111111 {
    rd = rs;
    if(rs s>= 0) goto inst_next;
    rd = -rs;
}

:acc.64.r rd64, rs is rd64 & rs & op0_23=0b111111111110011101111111 {
	# Assuming zext, PM doesn't make this clear
    rd64 = rd64 + zext(rs);
}

:add.c.r rd, rs, rt is rd & rs & op12_23=0b111111110000 & rt & op0_7=0b11111111 {
	local tmp:5 = sext(rs) + sext(rt) + zext(C);
    C = carry(rs, rt) || carry(rs + rt, zext(C));
    rd = tmp:4;
    V = (tmp s< 0) ^ (rd s< 0);
    flags_nz(rd);
}

:add.h rd, rs, "#"h_imm is rd & rs & h_imm & op0_6=0b1000001 {
	local tmp:5 = sext(rs) + sext(h_imm);
    C = carry(rs, h_imm);
    rd = tmp:4;
    V = (tmp s< 0) ^ (rd s< 0);
    flags_nz(rd);
}

:add.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1010001 {
    local tmp:5 = sext(rs) + imm;
    C = carry(rs, imm);
    rd = tmp:4;
    V = (tmp s< 0) ^ (rd s< 0);
    flags_nz(rd);
}

:add.i rd16, rt16 is rd16 & rt16 & op16_0_7=0b00110000 {
    local tmp:5 = sext(rd16) + sext(rt16);
    C = carry(rd16, rt16);
    rd16 = tmp:4;
    V = (tmp s< 0) ^ (rd16 s< 0);
    flags_nz(rd16);
}

#TODO: signed for imms?
:add.i rx3a, "#"imm16_4_10 is rx3a & op16_11_12=0b00 & imm16_4_10 & op16_0_4=0b0010 {
    local tmp:5 = sext(rx3a) + imm16_4_10;
    C = carry(rx3a, imm16_4_10);
    rx3a = tmp:4;
    V = (tmp s< 0) ^ (rx3a s< 0);
    flags_nz(rx3a);
}

:add.i rd3b, "#"imm16_4_10 is rd3b & op16_11_12=0b01 & imm16_4_10 & op16_0_4=0b0010 {
    local tmp:5 = sext(rd3b) + imm16_4_10;
    C = carry(rd3b, imm16_4_10);
    rd3b = tmp:4;
    V = (tmp s< 0) ^ (rd3b s< 0);
    flags_nz(rd3b);
}


:add.r rd, rs, rt is rd & rs & op12_23=0b111111110000 & rt & op0_7=0b01111111 {
    local tmp:5 = sext(rs) + sext(rt);
    C = carry(rs, rt);
    rd = tmp:4;
    V = (tmp s< 0) ^ (rd s< 0);
    flags_nz(rd);
}
:add.r rd16, rt16 is rd16 & rt16 & op16_0_7=0b00010000 {
    local tmp:5 = sext(rd16) + sext(rt16);
    C = carry(rd16, rt16);
    rd16 = tmp:4;
    V = (tmp s< 0) ^ (rd16 s< 0);
    flags_nz(rd16);
}

:and.h rd, rs, "#"h_imm is rd & rs & h_imm & op0_6=0b1000111 {
    rd = rs & h_imm;
    flags_nz(rd);
}
:and.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1010111 {
    rd = rs & imm;
    flags_nz(rd);
}

:and.r rd, rs, rt is rd & rs & op12_23=0b111111110011 & rt & op0_7=0b01111111 {
    rd = rs & rt;
    flags_nz(rd);
}
:and.r rd16, rt16 is rd16 & rt16 & op16_0_7=0b01000000 {
    rd16 = rd16 & rt16;
    flags_nz(rd16);
}

:bcase.2 rd, "#"imm is rd & op20_27=0b00010000 & imm & op0_6=0b1111111 {
    stub();
}
:bcase.4 rd, "#"imm is rd & op20_27=0b00100000 & imm & op0_6=0b1111111 {
    stub();
}

branch_tgt: tgt is offsetval [tgt = inst_next + (offsetval << 1);] {export *[const]:4 tgt; }
branch_tgt16: tgt is offset16 [tgt = inst_next + (offset16 << 1);] {export *[const]:4 tgt; }
branch_tgt16_4_13: tgt is offset16_4_13 [tgt = inst_next + (offset16_4_13 << 1);] {export *[const]:4 tgt; }
branch_tgt16_4_12: tgt is offset16_4_12 [tgt = inst_next + (offset16_4_12 << 1);] {export *[const]:4 tgt; }

bra_tgt: tgt is bra_offset [tgt = inst_next + (bra_offset << 1);] {export *[const]:4 tgt; }
bra_tgt16: tgt is bra_offset16 [tgt = inst_next + (bra_offset16 << 1);] {export *[const]:4 tgt; }

:bcc branch_tgt is op28_31=0b0101 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(C != 0) goto inst_next;
    goto [branch_tgt];
}
:bcc branch_tgt16 is op16_12_15=0b1111 & offset16 & op16_0_3=0b1100 & branch_tgt16 {
    if(C != 0) goto inst_next;
    goto [branch_tgt16];
}

:bcs branch_tgt is op28_31=0b0100 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(C == 0) goto inst_next;
    goto [branch_tgt];
}
:bcs branch_tgt16 is op16_12_15=0b1110 & offset16 & op16_0_3=0b1100 & branch_tgt16 {
    if(C == 0) goto inst_next;
    goto [branch_tgt16];
}

:beq branch_tgt is op28_31=0b0000 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(Z == 0) goto inst_next;
    goto [branch_tgt];
}
:beq branch_tgt16_4_13 is op16_14_15=0b00 & offset16_4_13 & op16_0_3=0b1100 & branch_tgt16_4_13 {
    if(Z == 0) goto inst_next;
    goto [branch_tgt16_4_13];
}

:bge.s branch_tgt is op28_31=0b1001 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(N != V) goto inst_next;
    goto [branch_tgt];
}
:bge.s branch_tgt16_4_12 is op16_13_15=0b101 & offset16_4_12 & op16_0_3=0b1100 & branch_tgt16_4_12 {
    if(Z == 0) goto inst_next;
    goto [branch_tgt16_4_12];
}

#bge.u is an alias for bcc

:bgt.s branch_tgt is op28_31=0b1011 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(C != 0) goto inst_next;
    goto [branch_tgt];
}

:bgt.u branch_tgt is op28_31=0b1101 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(C != 0) goto inst_next;
    if(Z != 0) goto inst_next;
    goto [branch_tgt];
}

:ble.s branch_tgt is op28_31=0b1010 & offsetval & op0_6=0b0101101 & branch_tgt {
    local skip:1 = (N == V) && (Z == 0);
    if(skip) goto inst_next;
    goto [branch_tgt];
}

:ble.u branch_tgt is op28_31=0b1100 & offsetval & op0_6=0b0101101 & branch_tgt {
    local skip:1 = (C == 0) && (Z == 0);
    if(skip) goto inst_next;
    goto [branch_tgt];
}

:blt.s branch_tgt is op28_31=0b1000 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(N == V) goto inst_next;
    goto [branch_tgt];
}
:blt.s branch_tgt16_4_12 is op16_13_15=0b100 & offset16_4_12 & op16_0_3=0b1100 & branch_tgt16_4_12 {
    if(N == V) goto inst_next;
    goto [branch_tgt16_4_12];
}

#blt.u is an alias for bcs 

:bmi branch_tgt is op28_31=0b0010 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(N == 0) goto inst_next;
    goto [branch_tgt];
}
:bmi branch_tgt16 is op16_12_15=0b1100 & offset16 & op16_0_3=0b1100 & branch_tgt16 {
    if(N == 0) goto inst_next;
    goto [branch_tgt16];
}

:bne branch_tgt is op28_31=0b0001 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(Z != 0) goto inst_next;
    goto [branch_tgt];
}
:bne branch_tgt16_4_13 is op16_14_15=0b01 & offset16_4_13 & op16_0_3=0b1100 & branch_tgt16_4_13 {
    if(Z != 0) goto inst_next;
    goto [branch_tgt16_4_13];
}

:bpl branch_tgt is op28_31=0b0011 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(N != 0) goto inst_next;
    goto [branch_tgt];
}
:bpl branch_tgt16 is op16_12_15=0b1101 & offset16 & op16_0_3=0b1100 & branch_tgt16 {
    if(N != 0) goto inst_next;
    goto [branch_tgt16];
}

:bra.a bra_tgt is bra_offset & op0_6=0b0110001 & bra_tgt {
    goto [bra_tgt];
}
:bra.p bra_tgt is bra_offset & op0_6=0b0110101 & bra_tgt {
    goto [bra_tgt];
}
:bra.p bra_tgt16 is op16_15=1 & bra_offset16 & op16_0_3=0b1010 & bra_tgt16 {
    goto [bra_tgt16];
}

:bra.r rs is op28_31=0 & rs & op0_23=0b111111111110110001111111 {
    goto [rs];
}
:bra.r rd16 is rd16 & op16_0_11=0b010000000000 {
    goto [rd16];
}

define pcodeop brk;
:brk is op0_31=0b11111111111111111111101011111111 {
    brk();
}
:brk is op16_0_15=0b0010000000000000 {
    brk();
}

:bsr.a addr is addr & op0_6=0b0110011 {
    R14_U = inst_next;
    local dest:4 = addr;
    goto [dest];
}

:bsr.p tgt is addr & op0_6=0b0110111 [tgt = inst_next + (addr << 1);] {
    R14_U = inst_next;
    local dest:4 = addr;
    goto [dest];
}

:bsr.r rs is op28_31=0 & rs & op0_23=0b111111111110110101111111 {
    R14_U = inst_next;
    goto [rs];
}
:bsr.r rd16 is rd16 & op16_0_11=0b010100000000 {
    R14_U = inst_next;
    goto [rd16];
}

:bvc branch_tgt is op28_31=0b0111 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(V == 0) goto inst_next;
    goto [branch_tgt];
}
:bvs branch_tgt is op28_31=0b0110 & offsetval & op0_6=0b0101101 & branch_tgt {
    if(V != 0) goto inst_next;
    goto [branch_tgt];
}

macro cmp_impl(a, b) {
    Z = a == b;
    N = a s< b;
    C = a < b;
    V = sborrow(a, b);
}

##TODO: check these flags make sense
:cmp.16.h rs, "#"h_imm8_23 is op28_31=0b0100 & rs & h_imm8_23 & op0_7=0b01000101 {
	local a:2 = rs(2);
	local b:2 = h_imm8_23(2);
    cmp_impl(a, b);
}
:cmp.16.i rs, "#"imm7_22 is op28_31=0b0100 & rs & op23=0 & imm7_22 & op0_6=0b1010101 {
    cmp_impl(rs:2, imm7_22:2);
}

:cmp.16.r rs, rt is op28_31=0b0100 & rs & op12_23=0b111111110010 & rt & op0_7=0b01111111 {
    cmp_impl(rs:2, rt:2);
}

:cmp.16c.h rs, "#"h_imm8_23 is op28_31=0b0110 & rs & h_imm8_23 & op0_7=0b01000101 {
	local tmp:2 = rs(2);
	local tmpimm:2 = h_imm8_23(2);
    Z = Z && ((tmpimm + zext(C)) == tmp);
    N = rs s< sext(tmpimm+zext(C));
    C = rs < sext(tmpimm + zext(C));
    V = sborrow(rs, sext(tmpimm+zext(C)));
}

:cmp.16c.i rs, "#"imm7_22 is op28_31=0b0110 & rs & op23=0 & imm7_22 & op0_6=0b1010101 {
    Z = ((imm7_22:2 + zext(C)) == rs:2);
    N = rs s< (imm7_22+zext(C));
    C = rs < (imm7_22 + zext(C));
    V = sborrow(rs, imm7_22+zext(C));
}
:cmp.16c.r rs, rt is op28_31=0b0110 & rs & op12_23=0b111111110010 & rt & op0_7=0b01111111 {
    Z = ((rt:2 + zext(C)) == rs:2);
    N = rs s< (rt+zext(C));
    C = rs < (rt + zext(C));
    V = sborrow(rs, rt+zext(C));
}
#
:cmp.16x.h rs, "#"h_imm8_23 is op28_31=0b0101 & rs & h_imm8_23 & op0_7=0b01000101 {
	local a:2 = rs(2);
	local b:2 = h_imm8_23(2);
    cmp_impl(b, a);
}
:cmp.16x.i rs, "#"imm7_22 is op28_31=0b0101 & rs & op23=0 & imm7_22 & op0_6=0b1010101 {
    cmp_impl(imm7_22:2, rs:2);
}

:cmp.16xc.h rs, "#"h_imm8_23 is op28_31=0b0111 & rs & h_imm8_23 & op0_7=0b01000101 {
	local a:2 = rs(2);
	local tmpimm:2 = h_imm8_23(2);
    Z = ((tmpimm + zext(C)) == a);
    N = (h_imm8_23+zext(C)) s< rs;
    C = (h_imm8_23 + zext(C)) < rs;
    V = sborrow(h_imm8_23+zext(C), rs);
}
