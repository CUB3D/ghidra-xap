define endian=big;
define alignment=2;

define space ram     type=ram_space      size=4  default;

define space register type=register_space size=2;

# R8 and R10 for 64bit ops use a R8:R9 and R10:R11 register pair, make sure this offset doesn't change
define register offset=0x30 size=8 [
	R8_64
	R10_64
];

#TODO: support for R0, == 0
define register offset=0x00 size=4 [
    R1_U
    R1_S
    R1_I
    R1_N
    R2_U
    R2_S
    R2_I
    R3
    R4
    R5
    R6
    R7
