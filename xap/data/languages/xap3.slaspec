:div.s.r rd, rs, rt is rd & rs & op12_23=0b111111111010 & rt & op0_7=0b01111111 {
    rd = rs s/ rt;
    flags_nz(rd);
    # Only in priv mode
    V = (rt == 0) || ((rs == 0x80000000) && (rd==-1));
}
:div.u.r rd, rs, rt is rd & rs & op12_23=0b111111111011 & rt & op0_7=0b01111111 {
    rd = rs s/ rt;
    flags_nz(rd);
    # Only in priv mode
    C = (rt == 0);
}

