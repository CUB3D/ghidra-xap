    BRK4
    BRK5
    BRK6
    BRK7
    BRK4COUNT
    BRK5COUNT
    BRK6COUNT
    BRK7COUNT
    BRK8MASK
    BRK7MASK
    BRK6DATA
    BRK7DATA
];


#define register offset=0x100 size=4 [
    #ctx
#];

#define context ctx
    #addrExt         = (  0, 31) noflow
#;

define bitrange E=flags[8,1]
                T=flags[7,1]
				B=flags[6,1]
				M1=flags[5,1]
				M0=flags[4,1]
				V=flags[3,1]
                C=flags[2,1]
                N=flags[1,1]
                Z=flags[0,1]
;

