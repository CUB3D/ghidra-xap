    R15_U
    R15_S
    R15_I

	flags
    SFLAGS_S
    SFLAGS_I
    SFLAGS_N

    GP_U
    GP_S
    GP_I

    IVTB
    BRKE

    BRK0
    BRK1
    BRK2
    BRK3
    BRK4
    BRK5
    BRK6
    BRK7
    BRK4COUNT
    BRK5COUNT
    BRK6COUNT
    BRK7COUNT
    BRK8MASK
    BRK7MASK
    BRK6DATA
    BRK7DATA
];


#define register offset=0x100 size=4 [
    #ctx
#];

#define context ctx
    #addrExt         = (  0, 31) noflow
#;

define bitrange E=flags[8,1]
                T=flags[7,1]
				B=flags[6,1]
				M1=flags[5,1]
				M0=flags[4,1]
				V=flags[3,1]
                C=flags[2,1]
                N=flags[1,1]
                Z=flags[0,1]
;

define token opbyte (32)
    op0_31 = (0, 31)
    op0_23 = (0, 23)
    op0_7  = (0, 7)
    op12_23  = (12, 23)
    op23  = (23, 23)
    imm  = (7, 23)
    imm8_23  = (8, 23)
    imm7_22  = (7, 22)
    addr  = (7, 31)
    rs     = (24, 27)
    rd     = (28, 31)
    rt     = (8, 11)
;

define token opbyte16 (16)
    op16_0_7   = (0, 7)
    rd16       = (12, 15)
    rt16       = (8, 11)
    op16_0_16  = (0, 15)
    op16_0_11  = (0, 11)
;

