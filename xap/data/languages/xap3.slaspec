define endian=big;
define alignment=2;

define space ram     type=ram_space      size=2  default;

define space register type=register_space size=2;

define register offset=0x00 size=4 [ 
    R1_U
    R1_S
    R1_I
    R1_N
    R2_U
    R2_S
    R2_I
    R3
    R4
