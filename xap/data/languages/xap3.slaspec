:bgt.s tgt is op28_31=0b1011 & offset & op0_6=0b0101101 [tgt = inst_next + (offset << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}

:bgt.u tgt is op28_31=0b1101 & offset & op0_6=0b0101101 [tgt = inst_next + (offset << 1);] {
    if(C != 0) goto inst_next;
    if(Z != 0) goto inst_next;
    goto [tgt];
}

:ble.s tgt is op28_31=0b1010 & offset & op0_6=0b0101101 [tgt = inst_next + (offset << 1);] {
    local skip:1 = (N == V) && (Z == 0);
    if(skip) goto inst_next;
    goto [tgt];
}

:ble.u tgt is op28_31=0b1100 & offset & op0_6=0b0101101 [tgt = inst_next + (offset << 1);] {
