    R8
    R9
    R10
    R11
    R12
    R13
    R14_U
    R14_S
    R14_I
    R14_N
    R15_U
    R15_S
    R15_I

	flags
    SFLAGS_S
    SFLAGS_I
    SFLAGS_N

    GP_U
    GP_S
    GP_I

    IVTB
    BRKE

    BRK0
    BRK1
    BRK2
    BRK3
    BRK4
    BRK5
    BRK6
    BRK7
    BRK4COUNT
    BRK5COUNT
    BRK6COUNT
    BRK7COUNT
    BRK6MASK
    BRK7MASK
    BRK6DATA
    BRK7DATA
    
    # Special register for multi load/stores
    ldm_src
];

define bitrange E=flags[8,1]
                T=flags[7,1]
				B=flags[6,1]
				M1=flags[5,1]
				M0=flags[4,1]
				V=flags[3,1]
                C=flags[2,1]
                N=flags[1,1]
                Z=flags[0,1]
;

