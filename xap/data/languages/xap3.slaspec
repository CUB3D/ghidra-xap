    R4
    R9
    R6
    R7
];

define pcodeop stub;

:abs.r rd, rs is rd & rs & op0_23=0b111111101101011111111111 {
    rd = rs;
    if(rs s>= 0) goto inst_next;
    rd = -rs;
}

:acc.64.r rd, rs is rd & rs & op0_23=0b111111111110011101111111 {
    stub();
}

:add.c.r rd, rs, rt is rd & rs & op12_23=0b111111110000 & rt & op0_7=0b11111111 {
    stub();
}

:add.h rd, rs, "#"imm is rd & rs & imm & op0_6=0b1000001 {
    stub();
}

:add.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1010001 {
    stub();
}

