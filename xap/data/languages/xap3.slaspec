:swap.r rd, "@(" rt, ra ")" is rd & rs & op12_23=0b111111101100 & rt & op0_7=0b01111111 {
	local ea:4 = (rt << 2) + ra;
    local a:4 = *[ram]:4 ea;
    *[ram]:4 ea = rd;
    rd = a;
    flags_nz(rd);
}

define pcodeop trap;
:trap.i is op20_31=0b000000000000 & imm7_19 & op0_6=0b1111111 {
	trap(imm7_19:2);
}
:trap.r rs is op28_31=0b0000 & rs & op0_27=0b111111111110111001111111 {
    trap(rd);
}

define pcodeop ver;
:ver rd is rd & op0_27=0b1111111111111111011111111111 {
    rd = ver();
}

:xor.h rd, rs, "#"h_imm is rd & rs & h_imm & op0_6=0b1001011 {
    rd = rs ^ h_imm;
    flags_nz(rd);
}
:xor.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1011011 {
    rd = rs ^ imm;
    flags_nz(rd);
}
:xor.i rd16 is rd16 & op16_0_11=0b000100000000 {
    rd16 = rd16 ^ 0xFFFFFFFF;
    flags_nz(rd16);
}
:xor.r rd, rs, rt is rd & rs & op12_13=0b111111110101 & rt & op0_7=0b01111111 {
    rd = rs ^ rt;
    flags_nz(rd);
}
:xor.r rd16, rt16 is rd16 & rt16 & op16_0_7=0b01100000 {
    rd16 = rd16 ^ rt16;
    flags_nz(rd16);
