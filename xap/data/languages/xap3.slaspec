:bcc tgt is op28_31=0b0101 & offset & op0_6=0b0101101 [tgt = inst_next + (offset << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}
:bcc tgt is op16_12_15=0b1111 & offset16 & op16_0_3=0b1100 [tgt = inst_next + (offset16 << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}

:bcs tgt is op28_31=0b0100 & offset & op0_6=0b0101101 [tgt = inst_next + (offset << 1);] {
    if(C == 0) goto inst_next;
    goto [tgt];
}
:bcs tgt is op16_12_15=0b1110 & offset16 & op16_0_3=0b1100 [tgt = inst_next + (offset16 << 1);] {
