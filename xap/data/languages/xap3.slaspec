define pcodeop halt;
:halt is op0_31=0b11111111111111111111101111111111 {
    halt();
}

define pcodeop irqd;
:irqd is op0_31=0b00000000111111111110010101111111 {
    irqd();
}

define pcodeop irqe;
:irqe is op0_31=0b00000000111111111110010001111111 {
    irqe();
}

define pcodeop irqs;
:irqs rd is rd & op0_27=0b0000111111111110011001111111 {
    irqs(rd);
}

