:bra.a tgt is bra_offset & op0_6=0b0110001 [tgt = (bra_offset << 1);] {
    goto [tgt];
}
:bra.p tgt is bra_offset & op0_6=0b0110101 [tgt = inst_next + (bra_offset << 1);] {
    goto [tgt];
}
:bra.p tgt is op16_15=1 & bra_offset16 & op16_0_3=0b1010 [tgt = inst_next + (bra_offset16 << 1);] {
    goto [tgt];
}

:bra.r rs is op28_31=0 & rs & op0_23=0b111111111110110001111111 {
    goto [rs];
}
:bra.r rd16 is rd16 & op16_0_11=0b010000000000 {
    goto [rd16];
}

define pcodeop brk;
:brk is op0_31=0b11111111111111111111101011111111 {
    brk();
}
:brk is op16_0_15=0b0010000000000000 {
    brk();
}

:bsr.a addr is addr & op0_6=0b0110011 {
    R14 = inst_next;
    goto [addr];
}

:bsr.p tgt is addr & op0_6=0b0110111 [tgt = inst_next + (addr << 1);] {
    R14 = inst_next;
    goto [tgt];
}

:bsr.r rs is op28_31=0 & rs & op0_23=0b111111111110110101111111 {
    R14 = inst_next;
    goto [rs];
}
:bsr.r rd16 is rd16 & op16_0_11=0b010100000000 {
    R14 = inst_next;
    goto [rd16];
}

:bvc tgt is op28_31=0b0111 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(V == 0) goto inst_next;
    goto [tgt];
}
:bvs tgt is op28_31=0b0110 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(V != 0) goto inst_next;
    goto [tgt];
}

macro cmp(a, b) {
    Z = a == b;
    N = a s< b;
    C = a < b;
    V = sborrow(a, b);
}

