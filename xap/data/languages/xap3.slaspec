    imm7_22  = (7, 22)
    addr  = (7, 31)
    rs     = (24, 27)
    rd     = (28, 31)
    rt     = (8, 11)
    bra_offset = (7, 31)
    sel = (16, 17)
    shift = (17, 21)
    highbit = (12, 16)
    lowbit = (7, 11)
    imm20_23 = (20, 23)
    imm7_19 = (7, 19)
    imm7_14 = (7, 14)
    imm15_23 = (15, 23)
    op12_13 = (12, 13)
    imm12_23 = (12, 23)
    op20_23 = (20, 23)
    op22_23 = (22, 23)
    op18_23 = (18, 23)
    op12_15 = (12, 15)
    op0_27 = (0, 27)
    op12_22 = (12, 22)
    imm7_23 = (7, 23)
    op12_27 = (12, 27)
    op18_27 = (18, 27)
