define pcodeop stub;

# Take bits [31:15] from imm, repeat bit [15] into [14:0] of the imm
h_imm: is imm {
	local b15:4 = zext(imm:2);
	local low:2 = imm:2 & 0x8000;
	low = low s>> 15;
	local tmp:4 = b15 | zext(low);
	export *[const]:4 tmp;
}

# Take bits [31:15] from imm, repeat bit [15] into [14:0] of the imm
h_imm8_23: is imm8_23 {
	local b15:4 = zext(imm8_23:2);
	local low:2 = imm8_23:2 & 0x8000;
	low = low s>> 15;
	local tmp:4 = b15 | zext(low);
	export *[const]:4 tmp;
}

macro flags_nz(dest) {
	Z = dest > 0;
	N = dest s< 0;
}

:abs.r rd, rs is rd & rs & op0_23=0b111111101101011111111111 {
    rd = rs;
    if(rs s>= 0) goto inst_next;
    rd = -rs;
}

:acc.64.r rd, rs is rd & rs & op0_23=0b111111111110011101111111 {
    stub();
}

:add.c.r rd, rs, rt is rd & rs & op12_23=0b111111110000 & rt & op0_7=0b11111111 {
    stub();
}

:add.h rd, rs, "#"h_imm is rd & rs & h_imm & op0_6=0b1000001 {
    rd = rs + h_imm;
}

:add.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1010001 {
    rd = rs + imm;
}

:add.i rd16, rt16 is rd16 & rt16 & op16_0_7=0b00110000 {
    rd16 = rd16 + rt16;
}

:add.i rx3a imm16_4_10 is rx3a & op16_11_12=0b00 & imm16_4_10 & op16_0_4=0b0010 {
    rd16 = rd16 + rt16;
}

:add.i rd3b imm16_4_10 is rd3b & op16_11_12=0b01 & imm16_4_10 & op16_0_4=0b0010 {
    rd16 = rd16 + rt16;
}

#TODO: all flags


:add.r rd, rs, rt is rd & rs & op12_23=0b111111110000 & rt & op0_7=0b01111111 {
    rd = rs + rt;
}
:add.r rd16, rt16 is rd16 & rt16 & op16_0_7=0b00010000 {
    rd16 = rd16 + rt16;
}

:and.h rd, rs, "#"h_imm is rd & rs & h_imm & op0_6=0b1000111 {
    rd = rs & h_imm;
    flags_nz(rd);
}
:and.i rd, rs, "#"imm is rd & rs & imm & op0_6=0b1010111 {
    rd = rs & imm;
    flags_nz(rd);
}

:and.r rd, rs, rt is rd & rs & op12_23=0b111111110011 & rt & op0_7=0b01111111 {
    rd = rs & rt;
    flags_nz(rd);
}
:and.r rd16, rt16 is rd16 & rt16 & op16_0_7=0b01000000 {
    rd16 = rd16 & rt16;
    flags_nz(rd);
}

:bcase.2 rd, "#"imm is rd & op20_27=0b00010000 & imm & op0_6=0b1111111 {
    stub();
}
:bcase.4 rd, "#"imm is rd & op20_27=0b00100000 & imm & op0_6=0b1111111 {
    stub();
}

:bcc tgt is op28_31=0b0101 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}
:bcc tgt is op16_12_15=0b1111 & offset16 & op16_0_3=0b1100 [tgt = inst_next + (offset16 << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}

:bcs tgt is op28_31=0b0100 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(C == 0) goto inst_next;
    goto [tgt];
}
:bcs tgt is op16_12_15=0b1110 & offset16 & op16_0_3=0b1100 [tgt = inst_next + (offset16 << 1);] {
    if(C == 0) goto inst_next;
    goto [tgt];
}

:beq tgt is op28_31=0b0000 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(Z == 0) goto inst_next;
    goto [tgt];
}
:beq tgt is op16_14_15=0b00 & offset16_4_13 & op16_0_3=0b1100 [tgt = inst_next + (offset16_4_13 << 1);] {
    if(Z == 0) goto inst_next;
    goto [tgt];
}

:bge.s tgt is op28_31=0b1001 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(N != V) goto inst_next;
    goto [tgt];
}
:bge.s tgt is op16_13_15=0b101 & offset16_4_12 & op16_0_3=0b1100 [tgt = inst_next + (offset16_4_12 << 1);] {
    if(Z == 0) goto inst_next;
    goto [tgt];
}

:bge.u tgt is op28_31=0b0101 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}
:bge.u tgt is op16_12_15=0b1111 & offset16 & op16_0_3=0b1100 [tgt = inst_next + (offset16 << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}

:bgt.s tgt is op28_31=0b1011 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(C != 0) goto inst_next;
    goto [tgt];
}

:bgt.u tgt is op28_31=0b1101 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(C != 0) goto inst_next;
    if(Z != 0) goto inst_next;
    goto [tgt];
}

:ble.s tgt is op28_31=0b1010 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    local skip:1 = (N == V) && (Z == 0);
    if(skip) goto inst_next;
    goto [tgt];
}

:ble.u tgt is op28_31=0b1100 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    local skip:1 = (C == 0) && (Z == 0);
    if(skip) goto inst_next;
    goto [tgt];
}

:blt.s tgt is op28_31=0b1000 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
    if(N == V) goto inst_next;
    goto [tgt];
}
:blt.s tgt is op16_13_15=0b100 & offset16_4_12 & op16_0_3=0b1100 [tgt = inst_next + (offset16_4_12 << 1);] {
    if(N == V) goto inst_next;
    goto [tgt];
}

:blt.u tgt is op28_31=0b0100 & offsetval & op0_6=0b0101101 [tgt = inst_next + (offsetval << 1);] {
