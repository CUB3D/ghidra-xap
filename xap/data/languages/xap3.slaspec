:svc.r rd, rs, rt is rd & rs & op12_23=0b111100000111 & rt & op0_7=0b01111111 {
    rd = (zext(~V) * rs) + (zext(V)*rt);
}

:svs.i rd, rs, "#"imm7_19 is rd & rs & op20_23=0b0110 & imm7_19 & op0_7=0b0101111 {
    rd = (zext(V) * rs) + (zext(~V)*imm7_19);
}
:svs.r rd, rs, rt is rd & rs & op12_23=0b111100000110 & rt & op0_7=0b01111111 {
